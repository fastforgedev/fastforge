<Project Sdk="Microsoft.NET.Sdk">

  <!-- A minimal native Windows (.NET) project used by the .NET Builder and
       `fastforge package` tests. A console app keeps the fixture buildable
       without the Windows App SDK; the packaging path is the same as for a
       WinUI 3 project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyName>NativeWindowsFixture</AssemblyName>
    <Version>1.2.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
